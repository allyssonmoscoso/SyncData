<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyncData.Gui.ViewModels"
        x:Class="SyncData.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SyncData"
        Width="760" Height="620"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Update banner -->
        <Border Grid.Row="0"
                Background="#FFF3CD"
                BorderBrush="#FFE69C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12"
                IsVisible="{Binding Update.UpdateAvailable}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Update.AvailableVersion, StringFormat='Nueva versión disponible: {0}'}" />
                    <Button Grid.Column="1"
                            Content="Actualizar"
                            Margin="8,0,0,0"
                            Command="{Binding Update.ApplyUpdateCommand}" />
                    <Button Grid.Column="2"
                            Content="Omitir"
                            Margin="8,0,0,0"
                            Command="{Binding Update.DismissUpdateCommand}" />
                </Grid>
                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Update.DownloadProgress}"
                             IsVisible="{Binding Update.IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Origen -->
        <Grid Grid.Row="1" ColumnDefinitions="90,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Origen:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SourcePath}" Watermark="/ruta/origen" />
            <Button Grid.Column="2" Content="Elegir…" Margin="8,0,0,0" Click="OnBrowseSource" />
        </Grid>

        <!-- Destino -->
        <Grid Grid.Row="2" ColumnDefinitions="90,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Destino:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding TargetPath}" Watermark="/ruta/destino" />
            <Button Grid.Column="2" Content="Elegir…" Margin="8,0,0,0" Click="OnBrowseTarget" />
        </Grid>

        <!-- Opciones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <CheckBox Content="Verbose" IsChecked="{Binding Verbose}" />
            <CheckBox Content="Preservar permisos/tiempos" IsChecked="{Binding Preserve}" />
            <CheckBox Content="Log a archivo" IsChecked="{Binding LogToFile}" />
        </StackPanel>

        <!-- Excluir -->
        <Grid Grid.Row="4" ColumnDefinitions="90,*" Margin="0,0,0,12">
            <CheckBox Grid.Column="0" Content="Excluir:" IsChecked="{Binding ExcludeEnabled}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ExcludePaths}"
                     IsEnabled="{Binding ExcludeEnabled}"
                     Watermark="a.txt, carpeta, ... (separadas por coma)" />
        </Grid>

        <!-- Acciones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="Sincronizar" Command="{Binding StartSyncCommand}" MinWidth="120" />
            <Button Content="Cancelar" Command="{Binding CancelSyncCommand}" MinWidth="100" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progreso -->
        <ProgressBar Grid.Row="6" Height="20" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,12" />

        <!-- Log -->
        <Border Grid.Row="7" BorderBrush="#33888888" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding LogEntries}" />
        </Border>

        <!-- Update footer -->
        <Grid Grid.Row="8" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Text="{Binding Update.StatusMessage}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       Opacity="0.6"
                       Text="{Binding Update.CurrentVersion, StringFormat='v{0}'}" />
            <Button Grid.Column="2"
                    Content="Buscar actualizaciones"
                    Command="{Binding Update.CheckForUpdatesCommand}" />
        </Grid>
    </Grid>
</Window>
