<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyncData.Gui.ViewModels"
        xmlns:loc="using:SyncData.Gui.Localization"
        x:Class="SyncData.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{ReflectionBinding Path=[App_Title], Source={x:Static loc:Localizer.Instance}}"
        Width="780" Height="640"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Update banner -->
        <Border Grid.Row="0"
                Background="#FFF3CD"
                BorderBrush="#FFE69C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12"
                IsVisible="{Binding Update.UpdateAvailable}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Update.UpdateBannerText}" />
                    <Button Grid.Column="1"
                            Content="{ReflectionBinding Path=[Action_Update], Source={x:Static loc:Localizer.Instance}}"
                            Margin="8,0,0,0"
                            Command="{Binding Update.ApplyUpdateCommand}" />
                    <Button Grid.Column="2"
                            Content="{ReflectionBinding Path=[Action_Dismiss], Source={x:Static loc:Localizer.Instance}}"
                            Margin="8,0,0,0"
                            Command="{Binding Update.DismissUpdateCommand}" />
                </Grid>
                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Update.DownloadProgress}"
                             IsVisible="{Binding Update.IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Origen -->
        <Grid Grid.Row="1" ColumnDefinitions="90,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{ReflectionBinding Path=[Label_Source], Source={x:Static loc:Localizer.Instance}}" />
            <TextBox Grid.Column="1"
                     Text="{Binding SourcePath}"
                     Watermark="{ReflectionBinding Path=[Watermark_Source], Source={x:Static loc:Localizer.Instance}}" />
            <Button Grid.Column="2"
                    Content="{ReflectionBinding Path=[Action_Choose], Source={x:Static loc:Localizer.Instance}}"
                    Margin="8,0,0,0"
                    Click="OnBrowseSource" />
        </Grid>

        <!-- Destino -->
        <Grid Grid.Row="2" ColumnDefinitions="90,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{ReflectionBinding Path=[Label_Target], Source={x:Static loc:Localizer.Instance}}" />
            <TextBox Grid.Column="1"
                     Text="{Binding TargetPath}"
                     Watermark="{ReflectionBinding Path=[Watermark_Target], Source={x:Static loc:Localizer.Instance}}" />
            <Button Grid.Column="2"
                    Content="{ReflectionBinding Path=[Action_Choose], Source={x:Static loc:Localizer.Instance}}"
                    Margin="8,0,0,0"
                    Click="OnBrowseTarget" />
        </Grid>

        <!-- Opciones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <CheckBox Content="{ReflectionBinding Path=[Option_Verbose], Source={x:Static loc:Localizer.Instance}}"
                      IsChecked="{Binding Verbose}" />
            <CheckBox Content="{ReflectionBinding Path=[Option_Preserve], Source={x:Static loc:Localizer.Instance}}"
                      IsChecked="{Binding Preserve}" />
            <CheckBox Content="{ReflectionBinding Path=[Option_LogToFile], Source={x:Static loc:Localizer.Instance}}"
                      IsChecked="{Binding LogToFile}" />
        </StackPanel>

        <!-- Excluir -->
        <Grid Grid.Row="4" ColumnDefinitions="90,*" Margin="0,0,0,12">
            <CheckBox Grid.Column="0"
                      Content="{ReflectionBinding Path=[Label_Exclude], Source={x:Static loc:Localizer.Instance}}"
                      IsChecked="{Binding ExcludeEnabled}"
                      VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding ExcludePaths}"
                     IsEnabled="{Binding ExcludeEnabled}"
                     Watermark="{ReflectionBinding Path=[Watermark_Exclude], Source={x:Static loc:Localizer.Instance}}" />
        </Grid>

        <!-- Acciones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="{ReflectionBinding Path=[Action_Sync], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding StartSyncCommand}" MinWidth="120" />
            <Button Content="{ReflectionBinding Path=[Action_Cancel], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding CancelSyncCommand}" MinWidth="100" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progreso -->
        <ProgressBar Grid.Row="6" Height="20" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,12" />

        <!-- Log -->
        <Border Grid.Row="7" BorderBrush="#33888888" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding LogEntries}" />
        </Border>

        <!-- Footer: status, language, version and update check -->
        <Grid Grid.Row="8" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Text="{Binding Update.StatusMessage}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                <TextBlock VerticalAlignment="Center"
                           Text="{ReflectionBinding Path=[Label_Language], Source={x:Static loc:Localizer.Instance}}" />
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="loc:Language">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       Opacity="0.6"
                       Text="{Binding Update.CurrentVersion, StringFormat='v{0}'}" />

            <Button Grid.Column="3"
                    Content="{ReflectionBinding Path=[Action_CheckUpdates], Source={x:Static loc:Localizer.Instance}}"
                    Command="{Binding Update.CheckForUpdatesCommand}" />
        </Grid>
    </Grid>
</Window>
